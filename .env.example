# ── Core ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://schoolpawa:schoolpawa@localhost:5432/schoolpawa
# Leave empty in dev to use the in-memory store (single process only).
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# 32+ random bytes each, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Pepper for phone-number HMAC. Changing it orphans every guardian record — store in a vault.
PHONE_HASH_PEPPER=change-me-phone-pepper-at-least-32-chars
CRON_SECRET=change-me-cron-secret

# ── Compliance (PRD §7) ───────────────────────────────────────────────
# Where the primary database physically lives. Anything other than "tz" logs a cross-border
# transfer warning at boot; document the adequacy basis in docs/hosting-decision.md.
DATA_RESIDENCY=tz
DB_REGION=tz-dar-es-salaam-1
POLICY_VERSION=2026-10-01
DPO_CONTACT=dpo@schoolpawa.example
RETENTION_INACTIVE_DAYS=365

# ── SMS (Africa's Talking) ────────────────────────────────────────────
# console = print OTPs to the server log (dev). africastalking = real SMS.
SMS_DRIVER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ── Game tuning ───────────────────────────────────────────────────────
SCHOOL_POWER_C=20
TOPIC_LIVE_MIN=60
MAX_PROFILES_PER_DEVICE=4
FLAG_THRESHOLD=3
OFFLINE_DAILY_POINT_CAP=150
BLOCKED_TERMS_EXTRA=

# ── Seed ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@schoolpawa.example
SEED_ADMIN_PASSWORD=change-me-admin-password
# Dev only: approve seed content so topics go live without a teacher review.
SEED_APPROVE_CONTENT=false
